---
import { site } from '@data/site';
import { Icon } from 'astro-icon/components';
---

<div class="flex items-center gap-1">
  <a
    href={site.contact.github}
    class="subtle-link inline-flex h-9 w-9 items-center justify-center rounded"
    target="_blank"
    rel="noreferrer"
    aria-label="GitHub"
  >
    <Icon name="ph:github-logo" class="h-8 w-8" />
  </a>
  <a
    href={site.contact.steam}
    class="subtle-link inline-flex h-9 w-9 items-center justify-center rounded"
    target="_blank"
    rel="noreferrer"
    aria-label="Steam"
  >
    <Icon name="ph:steam-logo" class="h-8 w-8" />
  </a>
  <a
    href={`mailto:${site.contact.email}`}
    class="subtle-link inline-flex h-9 w-9 items-center justify-center rounded"
    aria-label="Email"
  >
    <Icon name="ph:envelope-simple" class="h-8 w-8" />
  </a>
  <a
    href={`${site.contact.discord}`}
    class="subtle-link inline-flex h-9 w-9 items-center justify-center rounded"
    aria-label="Discord"
  >
    <Icon name="ph:discord-logo" class="h-8 w-8" />
  </a>
</div>
